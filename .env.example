# Canonical site URL (no trailing slash). Used for canonical tags, sitemap, OG images.
NEXT_PUBLIC_SITE_URL=https://www.ajtoolbox.com

# Google AdSense — leave empty until your account is approved.
# Publisher ID looks like: ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Ad unit (slot) IDs from AdSense > Ads > By ad unit. Numeric strings.
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_BELOW=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_CONTENT=

# Set to "true" to show grey ad placeholders in production (they always show in dev).
NEXT_PUBLIC_SHOW_AD_PLACEHOLDERS=false
